# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=

# ---------------------------------------------------------------------------------------------------
# Web / deploy (codebase/web.py, Dockerfile). Chạy local: để trống phần này là đủ.
# Railway / Render: điền các biến dưới (và 3 biến model ở trên) trên dashboard, KHÔNG chép file .env lên.
# ---------------------------------------------------------------------------------------------------
# HOST: địa chỉ nghe. Local mặc định 127.0.0.1. Dockerfile đã đặt sẵn 0.0.0.0 — không cần điền khi deploy.
HOST=
# PORT: cổng nghe, mặc định 8000. Railway / Render tự cấp $PORT — không cần điền.
PORT=
# APP_PASSWORD: BẮT BUỘC khi deploy công khai. Bật đăng nhập HTTP Basic cho mọi trang + API (trừ /api/health).
#   Thiếu biến này mà nghe 0.0.0.0 → server từ chối khởi động (để không lộ câu trả lời của lớp và API key).
#   Dùng chuỗi dài, ngẫu nhiên; gửi riêng cho TA, không dán vào repo / slide.
APP_PASSWORD=
# APP_USER: tên đăng nhập, mặc định "ta".
APP_USER=
# ALLOW_NO_AUTH: đặt 1 để CHỦ ĐỘNG mở công khai không mật khẩu (không khuyến nghị — ai có URL cũng gọi model bằng key của nhóm).
ALLOW_NO_AUTH=
# WEB_RUNTIME_DIR: nơi lưu SQLite (câu hỏi TA import + bản nháp). Dockerfile mặc định /app/data/runtime.
#   Container mất dữ liệu khi redeploy nếu không gắn volume: Railway → Volume mount /app/data/runtime
#   (nếu lỗi quyền ghi: thêm RAILWAY_RUN_UID=0); Render → Disk mount /app/data/runtime.
WEB_RUNTIME_DIR=
# WEB_CORS_ORIGINS: thêm origin được gọi API từ trình duyệt (phân tách bằng dấu phẩy). Bản deploy phục vụ UI cùng
#   domain nên KHÔNG cần; mặc định đã cho http://localhost:5173 (Vite dev).
WEB_CORS_ORIGINS=
